# ─── Database ───────────────────────────────────────────
# Dev (SQLite — zero-config, file-based):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/quantbacktest"

# ─── Authentication ────────────────────────────────────
JWT_SECRET="change-this-to-a-secure-random-string-in-production"

# ─── Optional Social OAuth Providers ──────────────────
# Quant Backtest Pro automatically detects configured providers.
# If these variables are empty or omitted, unconfigured SSO options
# are cleanly hidden from the UI to avoid mock logins.

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth App (GitHub -> Settings -> Developer settings -> OAuth Apps)
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# Apple Sign-In (Apple Developer Portal -> Identifiers -> Services IDs)
# APPLE_CLIENT_ID="com.yourdomain.quantbacktest.service"
# APPLE_CLIENT_SECRET="your-apple-client-secret"
# APPLE_TEAM_ID="your-apple-team-id"

# ─── Server ────────────────────────────────────────────
PORT=3001

